{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npm test",
            "if": "Bash(git commit*)",
            "statusMessage": "Running tests before commit..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-scan.sh",
            "if": "Bash(git commit*)",
            "statusMessage": "Scanning staged diff for secrets..."
          }
        ]
      }
    ]
  }
}
